# Where this deployment lives.  Every QR code, link and share card carries
# the whole URL: <origin>#<64-hex content address>, for example
# https://kant.cicada71.net/#ff810f291f187b808a0183f83c0466874573ef5c4c6d7d9ed430c6f7d710f605
#
# Lines are `key = value`; a line without an `=` is a comment.
# The grammar and the round trip are specified in RequestProject/Kant/SiteCard.lean.
origin = https://kant.cicada71.net/
caption = kant-zk-pastebin
picture = ./kant-logo.svg
alt = the Kant pastebin logo

# The rendezvous relay.  Two tabs of one browser find each other with no
# server at all, but two *devices* need something they can both reach.  Put
# the base URL of a deployed `server/relay.mjs` or `server/worker.js` here —
# no trailing slash — and the client will use it and put it in every invite.
#
#   relay = https://relay.kant.cicada71.net
#
# Left empty, the client asks the origin it was served from whether it is
# itself a relay (`GET /health`).  Serving the page with
#
#   node server/relay.mjs --static web
#
# is therefore enough to make two browsers on one machine talk, with no
# configuration at all.  If the origin is a plain static host the client
# says so, loudly, on the share screen, rather than pretending that a link
# works when it cannot.  The rule is `effectiveRelay` in
# RequestProject/Kant/Connectivity.lean.
relay =
