[Unit]
Description=kant-zk rendezvous relay
Documentation=https://github.com/meta-introspector/kant-zk-pastebin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kantzk
Group=kantzk
WorkingDirectory=/opt/kant-zk-pastebin
ExecStart=/usr/bin/node /opt/kant-zk-pastebin/server/relay.mjs --port 8787 --host 127.0.0.1 --static /opt/kant-zk-pastebin/web
Restart=on-failure
RestartSec=2

# The relay keeps everything in memory and needs nothing from the disk
# beyond the static files it serves.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/kant-zk-pastebin
MemoryMax=512M

[Install]
WantedBy=multi-user.target
