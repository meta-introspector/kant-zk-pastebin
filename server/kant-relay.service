[Unit]
Description=kant-zk rendezvous relay — systemd-driven thunk scheduler
Documentation=https://github.com/meta-introspector/kant-zk-pastebin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/mnt/data1/kant/pastebin
# Thunk store + schedule manifest live under state/ (git-ignored).
ExecStart=/usr/bin/node /mnt/data1/kant/pastebin/server/scheduler.mjs --store /mnt/data1/kant/pastebin/state/thunks --port 8787 --host 127.0.0.1 --static /mnt/data1/kant/pastebin/web
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/mnt/data1/kant/pastebin
MemoryMax=512M

[Install]
WantedBy=multi-user.target
