[Unit]
Description=kant-zk archive pairer — local archive server ⇄ Cloudflare twin
Documentation=https://github.com/meta-introspector/kant-zk-pastebin
After=network-online.target kant-archive.service
Wants=network-online.target

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/home/mdupont/projects/pastebin-lean
# TWIN_URL: the workers.dev URL of the CF relay twin (set per-host).
Environment=TWIN_URL=https://kant-zk-relay.solfunmeme.workers.dev
ExecStart=/usr/bin/node /home/mdupont/projects/pastebin-lean/server/pair.mjs --local http://127.0.0.1:8788 --twin ${TWIN_URL} --archive-dir /var/lib/kant-zk/archive --interval 60
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/kant-zk /home/mdupont/projects/pastebin-lean
MemoryMax=256M

[Install]
WantedBy=multi-user.target
