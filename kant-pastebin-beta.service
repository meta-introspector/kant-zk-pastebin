[Unit]
Description=Kant Pastebin Beta (commit ac9553cf427bb77186f8bf9a9a11bb167ba4faac)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/kant/pastebin
ExecStart=/mnt/data1/kant/pastebin/target/release/kant-pastebin
Restart=always
RestartSec=10
Environment="UUCP_SPOOL=/mnt/data1/spool/uucp/pastebin"
Environment="BIND_ADDR=127.0.0.1:8085"
Environment="PORT=8085"
Environment="BASE_PATH=/pastebin/beta"
Environment="BASE_URL=https://solana.solfunmeme.com"
Environment="RUST_LOG=info"
Environment="GIT_COMMIT=ac9553cf427bb77186f8bf9a9a11bb167ba4faac"
Environment="BUILD_TIME=2026-10-28T13:36:27Z"
TimeoutStartSec=0
TimeoutStopSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
