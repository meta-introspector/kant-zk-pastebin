[Unit]
Description=Kant Pastebin Beta (commit 552c16cd22443c4d7dbf969579c6909e9b6ca70f)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/kant/pastebin
ExecStart=/mnt/data1/kant/pastebin/target/release/kant-pastebin
Restart=always
RestartSec=10
Environment="UUCP_SPOOL=/mnt/data1/spool/uucp/pastebin"
Environment="BIND_ADDR=127.0.0.1:8085"
Environment="PORT=8085"
Environment="BASE_PATH=/pastebin/beta"
Environment="BASE_URL=https://solana.solfunmeme.com"
Environment="RUST_LOG=info"
Environment="GIT_COMMIT=552c16cd22443c4d7dbf969579c6909e9b6ca70f"
Environment="BUILD_TIME=2026-11-02T01:18:01Z"
TimeoutStartSec=0
TimeoutStopSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
