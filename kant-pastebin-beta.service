[Unit]
Description=Kant Pastebin Beta (commit 172b27eb144c11ea3a645a92fb0276bc5dfc8081)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/data1/kant/pastebin
ExecStart=/mnt/data1/kant/pastebin/target/release/kant-pastebin
Restart=always
RestartSec=10
Environment="UUCP_SPOOL=/mnt/data1/spool/uucp/pastebin"
Environment="BIND_ADDR=127.0.0.1:8085"
Environment="PORT=8085"
Environment="BASE_PATH=/pastebin/beta"
Environment="BASE_URL=https://solana.solfunmeme.com"
Environment="RUST_LOG=info"
Environment="GIT_COMMIT=172b27eb144c11ea3a645a92fb0276bc5dfc8081"
Environment="BUILD_TIME=2026-10-28T14:04:05Z"
TimeoutStartSec=0
TimeoutStopSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
