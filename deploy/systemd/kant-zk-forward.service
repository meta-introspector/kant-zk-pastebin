# kant-zk-forward.service — standalone systemd unit
# Extracted from system-manager config. No nix store paths.
#
# Install:
#   sudo cp kant-zk-forward.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable kant-zk-forward
#   sudo systemctl start kant-zk-forward
#
# Rooms come from a directory rather than a single invite, so a new room
# is picked up without editing this file; only the public room digest is
# used, never the secret.  State lives in /var/lib/kant-zk/forward.
#
# The pacing flags are load-bearing, not tuning.  The destination may be
# a Cloudflare Durable Object on the free tier, which bills storage
# *duration*: a 10s period with a 10s long poll holds the room open
# essentially forever, and a flat retry spends the same budget on a 500 as
# on a healthy poll.  60s/10s/900s holds a room ~17% of the time and
# backs off to 15 minutes when the destination stops answering.  See
# server/backoff.mjs.
#
# Note: the installed unit is managed from system-manager, not from here;
# this copy is kept in step by hand and has drifted before.

[Unit]
Description=Kant ZK Forward — self-maintaining room bridges to relay twins
After=network.target
# The bridge is a background sync service: if it is failing, restarting it
# immediately just repeats the failure and re-spends the destination's
# budget.  Give it room, and let its own backoff pace the retries.
# (StartLimit* belong in [Unit], not [Service].)
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=mdupont
Group=mdupont
WorkingDirectory=/home/mdupont/projects/pastebin-lean
Environment="KANT_ZK_INVITE=https://solana.solfunmeme.com/relay/#6b7a696e76697465:68747470733a2f2f736f6c616e612e736f6c66756e6d656d652e636f6d2f72656c6179:f436f2a7fc1378621989a2121aed902a53fe120ee4be013e1d412ed9a279c792:6c65747461"
ExecStart=/usr/bin/node server/forward.mjs \
  --rooms /var/lib/kant-zk/rooms \
  --default-from https://solana.solfunmeme.com/relay \
  --default-to https://kant-relay-v1.purple-fire-b881.workers.dev \
  --state-dir /var/lib/kant-zk/forward \
  --interval 60 --wait 10 --max-interval 900
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

# Hardening.
#
# No ProtectHome: the checkout is under /home (a symlink into /mnt), and
# ProtectHome=true makes /home inaccessible, so the unit fails at CHDIR
# with status=200/CHDIR before node ever starts.  ProtectHome=read-only
# would allow the chdir but is deliberately not assumed here — the unit
# that shipped and ran had no hardening, and adding an untested sandbox
# around a service that syncs rooms is not a change to make quietly.
# Reintroduce it with ProtectHome=read-only and a live restart to prove it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kant-zk
MemoryMax=512M

[Install]
WantedBy=multi-user.target
